// Data model for the 10DLC A2P registration & monitoring dashboard.
// Two providers are supported per sub-account: Twilio and TextGrid.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  TWILIO
  TEXTGRID
}

enum BrandStage {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  FAILED
}

enum CampaignStage {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum CampaignHealth {
  UNKNOWN
  HEALTHY
  AT_RISK
  BLOCKED
}

enum PhoneStatus {
  UNASSIGNED
  PENDING_ASSIGNMENT
  ASSIGNED
  FAILED
}

enum AdminRole {
  SUPER_ADMIN
  RESTRICTED
}

enum DeliveryChannel {
  SMS
  MMS
  VOICE
}

// Our own 4-bucket mapping of Twilio's many raw statuses, for the delivery
// report's pie chart and summary tables. UNKNOWN covers anything still in
// flight (queued/sending/sent/ringing/in-progress/...) — not yet resolved.
enum DeliveryStatus {
  DELIVERED
  UNDELIVERED
  FAILED
  UNKNOWN
}

model SubAccount {
  id              String   @id @default(cuid())
  token           String   @unique // powers the unguessable /d/[token] URL
  businessName    String
  contactEmail    String?
  contactName     String?
  provider        Provider

  // Slug for this sub-account's compliance micro-site, e.g. "deancapitalllc"
  // serves https://deancapitalllc.axtion.app (landing/terms/privacy/optin).
  // Auto-generated from businessName at signup; used as the
  // termsAndConditionsLink/privacyPolicyLink host for campaign submissions.
  subdomain       String?  @unique

  // Which underlying messaging account this sub-account's numbers/campaigns live under.
  // Falls back to the platform-wide TWILIO_*/TEXTGRID_* env credentials when unset,
  // which is the common case for a single reseller account with per-client Messaging Services.
  // Set these only when a client has their own dedicated Twilio/TextGrid (sub)account.
  // NOTE: stored in plaintext for now — before onboarding customers with their own
  // credentials at scale, put field-level encryption in front of these two columns.
  providerAccountSid   String? // Twilio Account SID or TextGrid Account SID
  providerAuthToken    String? // Twilio Auth Token or TextGrid Auth Token

  // GoHighLevel context (app.axtion.ai whitelabel sub-account)
  ghlLocationId   String?
  ghlLocationName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Incremental delivery-report sync cursor — the cron/backfill re-pulls a
  // rolling recent window (not just "since this timestamp") because a
  // message's status can change after it's first fetched (queued -> delivered).
  lastDeliverySyncAt DateTime?

  brands        Brand[]
  campaigns     Campaign[]
  phoneNumbers  PhoneNumber[]
  statusEvents  StatusEvent[]
  optInSubmissions OptInSubmission[]
  deliveryEvents    DeliveryEvent[]
  accessGrants      SubAccountAccess[]

  @@index([provider])
}

// One row per (sub-account, provider): a sub-account isn't locked to a single
// carrier — it can hold a brand registration under Twilio, TextGrid, or both,
// chosen per submission based on that client's actual needs.
model Brand {
  id                String     @id @default(cuid())
  subAccountId      String
  subAccount        SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  provider          Provider

  providerBrandId   String? // Twilio Brand SID (BNxxx) or TextGrid equivalent

  legalBusinessName String
  ein               String?
  businessType      String?
  vertical          String?
  website           String?
  street            String?
  city              String?
  state             String?
  postalCode        String?
  country           String?
  contactEmail      String?
  contactPhone      String?

  repFirstName      String?
  repLastName       String?
  repEmail          String?
  repPhone          String?
  repBusinessTitle  String?
  repJobPosition    String?

  stage             BrandStage @default(NOT_SUBMITTED)
  failureReason     String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  rawPayload        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subAccountId, provider])
  @@index([subAccountId])
}

// A campaign is also tagged with its own provider, independent of its sibling
// campaigns on the same sub-account — e.g. a Marketing campaign on TextGrid and
// an Account Notification campaign on Twilio for the same client.
model Campaign {
  id                 String        @id @default(cuid())
  subAccountId       String
  subAccount         SubAccount    @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  provider           Provider

  providerCampaignId String? // Twilio Campaign SID (CU/QE) or TextGrid equivalent
  messagingServiceSid String? // Twilio Messaging Service SID this campaign is bound to

  useCase            String
  description        String
  sampleMessages     Json    // string[]
  optInDetails       String?
  optInImageUrl      String?
  hasEmbeddedLinks   Boolean @default(false)
  hasEmbeddedPhone   Boolean @default(false)
  termsAndConditionsLink String?
  privacyPolicyLink      String?
  optinMessage           String?
  optoutMessage          String?
  helpMessage            String?

  stage              CampaignStage  @default(NOT_SUBMITTED)
  health             CampaignHealth @default(UNKNOWN)
  throughputPerMinute Int?
  failureReason      String?
  submittedAt        DateTime?
  approvedAt         DateTime?
  rawPayload         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phoneNumbers PhoneNumber[]

  @@index([subAccountId])
}

// provider records which carrier's number inventory this was purchased from —
// needed even before a number is assigned to a campaign, since search/purchase
// itself is provider-specific.
model PhoneNumber {
  id             String       @id @default(cuid())
  subAccountId   String
  subAccount     SubAccount   @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  provider       Provider
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id])

  e164           String       @unique
  providerSid    String? // Twilio PN SID or TextGrid equivalent
  status         PhoneStatus  @default(UNASSIGNED)
  purchasedAt    DateTime?
  assignedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subAccountId])
  @@index([campaignId])
}

model StatusEvent {
  id           String     @id @default(cuid())
  subAccountId String
  subAccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  entityType String // BRAND | CAMPAIGN | PHONE_NUMBER | SUB_ACCOUNT
  entityId   String?
  message    String
  actor      String? // "system" | "admin" | provider name

  createdAt DateTime @default(now())

  @@index([subAccountId, createdAt])
}

// Dashboard login — replaces the old single-ADMIN_PASSWORD-env-var scheme.
// SUPER_ADMIN always sees spend and every sub-account; a RESTRICTED user only
// sees the sub-accounts listed in accessGrants, and spend only if canViewSpend.
model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String // scrypt, stored as "saltHex:hashHex"
  role         AdminRole @default(RESTRICTED)
  canViewSpend Boolean   @default(false) // ignored (treated as true) for SUPER_ADMIN
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessGrants SubAccountAccess[]
}

model SubAccountAccess {
  id     String @id @default(cuid())
  userId String
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  subAccountId String
  subAccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, subAccountId])
  @@index([subAccountId])
}

// One row per Twilio Message or Call, synced from the REST API — powers the
// delivery report (spend, sent/delivered/failed counts, reason codes, pie
// chart). providerSid makes re-syncs idempotent (upsert), which matters
// because a message's status/price can still change after first fetch.
model DeliveryEvent {
  id           String     @id @default(cuid())
  subAccountId String
  subAccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  providerSid String          @unique // Twilio Message SID (SM/MM) or Call SID (CA)
  channel     DeliveryChannel
  direction   String // Twilio's own direction string, e.g. outbound-api, inbound, outbound-call
  rawStatus   String // Twilio's own status string, kept verbatim for display/debugging
  status      DeliveryStatus // our 4-bucket mapping of rawStatus, used for filtering/charts

  errorCode    Int?
  errorMessage String?

  priceAmount Decimal? @db.Decimal(10, 5) // Twilio reports this as negative; stored as-is, abs() at display time
  priceUnit   String?

  occurredAt DateTime // date_sent ?? date_created (messages) / start_time (calls)
  createdAt  DateTime @default(now())

  @@index([subAccountId, occurredAt])
  @@index([occurredAt])
  @@index([status])
}

// A record of consent collected through a sub-account's public opt-in form
// (https://{subdomain}.axtion.app/optin). consentText is a snapshot of the
// exact disclosure shown at signup time, kept verbatim for compliance
// records even if the template copy changes later.
model OptInSubmission {
  id           String     @id @default(cuid())
  subAccountId String
  subAccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  name        String
  // Nullable at the DB level only so this migration doesn't break on any
  // pre-existing rows — required by the form/zod validation for every new submission.
  email       String?
  phone       String
  consentText String
  // SMS opt-in is its own, optional checkbox — a submission can exist with no
  // SMS categories accepted (just contact info collected), matching the site's
  // "Consent is not a condition of purchase" policy language.
  smsOptedIn  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([subAccountId, createdAt])
}
